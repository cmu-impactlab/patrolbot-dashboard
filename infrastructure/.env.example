# Active auth configuration for the local compose stack.
#
# OIDC against the dev stand-in IdP (scripts/dev_idp.py on :9100) for local
# development. For staging/production, authenticate with Google OAuth2 and
# restrict sign-in to the andrew.cmu.edu Workspace domain (see below).
PATROLBOT_AUTH_MODE=oidc
PATROLBOT_OIDC_ISSUER=http://127.0.0.1:9100
PATROLBOT_OIDC_CLIENT_ID=dashboard
PATROLBOT_OIDC_CLIENT_SECRET=dev-oidc-secret
PATROLBOT_OIDC_REDIRECT_URL=http://localhost:8000/auth/callback
# Only these Andrew IDs may sign in (tighter filter on top of the domain check).
# Single-user lockdown: just yousefh. Add more comma-separated IDs to widen.
PATROLBOT_ALLOWED_USERNAMES=yousefh
# Command authorization is READ-ONLY by default. Admins and operators are the
# only roles allowed to send commands; everyone else who signs in is an
# observer. List them explicitly.
PATROLBOT_ADMIN_USERNAMES=yousefh
PATROLBOT_OPERATOR_USERNAMES=
# A verified email must end with @<this domain>. Empty disables the check, but
# production startup refuses to run without it.
PATROLBOT_OIDC_EMAIL_DOMAIN=andrew.cmu.edu
PATROLBOT_SESSION_SECRET=change-me

# ---------------------------------------------------------------------------
# Google OAuth2 (staging/production) — restrict to @andrew.cmu.edu
# ---------------------------------------------------------------------------
# Google is a standard OIDC provider, so the same flow works — just point the
# issuer at Google and register the callback in the Google Cloud Console.
#
#   PATROLBOT_OIDC_ISSUER=https://accounts.google.com
#   PATROLBOT_OIDC_CLIENT_ID=<client id from Google Cloud Console>
#   PATROLBOT_OIDC_CLIENT_SECRET=<client secret>
#   PATROLBOT_OIDC_REDIRECT_URL=https://<host>/auth/callback
#   PATROLBOT_OIDC_EMAIL_DOMAIN=andrew.cmu.edu
#
# Google Cloud Console setup (APIs & Services):
#   1. Create a project; configure the OAuth consent screen (External).
#   2. Credentials > Create Credentials > OAuth client ID > Web application.
#   3. Authorized redirect URI: https://<host>/auth/callback
#      (the dashboard uses /auth/callback, NOT the Django example's
#       /oauth/complete/google-oauth2/).
#   4. Copy the Client ID / Client Secret into the vars above.
# The domain restriction (email endswith @andrew.cmu.edu, email_verified) is
# enforced server-side in server/app/authentication/oidc.py.
