# Production configuration for patrolbot-dashboard.qatar.cmu.edu.
#
# Copy this file to infrastructure/.env on the server, fill every required
# blank, and keep that .env file out of Git. Generate independent random
# values for the robot token and session secret:
#
#   openssl rand -hex 32
#
# The robot token must also be installed as WEB_BRIDGE_TOKEN on the RPi5.

# Required secrets. Do not reuse either value elsewhere.
PATROLBOT_ROBOT_TOKEN=
PATROLBOT_SESSION_SECRET=

# Google OIDC credentials. Register the redirect URL below as an authorized
# redirect URI for the web application in Google Cloud.
PATROLBOT_OIDC_ISSUER=https://accounts.google.com
PATROLBOT_OIDC_CLIENT_ID=
PATROLBOT_OIDC_CLIENT_SECRET=
PATROLBOT_OIDC_REDIRECT_URL=https://patrolbot-dashboard.qatar.cmu.edu/auth/callback

# Access policy.
PATROLBOT_OIDC_EMAIL_DOMAIN=andrew.cmu.edu
PATROLBOT_ALLOWED_ORIGINS=https://patrolbot-dashboard.qatar.cmu.edu

# Comma-separated Andrew IDs. An empty allowed-usernames list permits any
# verified @andrew.cmu.edu account to sign in. Empty operator/admin lists keep
# every signed-in user read-only.
PATROLBOT_ALLOWED_USERNAMES=
PATROLBOT_OPERATOR_USERNAMES=
PATROLBOT_ADMIN_USERNAMES=
