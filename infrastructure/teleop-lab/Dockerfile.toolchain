# Test tools only: runtime tests are network-isolated and have no robot devices.
FROM patrolbot-ros-tests:latest
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
      ros-jazzy-twist-mux ros-jazzy-nav2-velocity-smoother \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m pip install --break-system-packages --ignore-installed --no-cache-dir \
      'fastapi>=0.115' 'uvicorn[standard]>=0.30' 'pydantic>=2.8' \
      'pydantic-settings>=2.4' 'aiosqlite>=0.20' 'websockets>=13' \
      'httpx>=0.27' 'pytest>=8' 'pytest-asyncio>=0.24' \
      'pytest-timeout>=2.3' 'python-multipart>=0.0.9'
# psutil stays as the base image's Debian package; pip cannot replace it.
LABEL io.patrolbot.test-only="web-teleop-software-lab"
ENTRYPOINT ["/bin/bash", "-lc"]
