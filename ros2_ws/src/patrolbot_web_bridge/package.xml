<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>patrolbot_web_bridge</name>
  <version>0.1.0</version>
  <description>
    Read-only telemetry bridge: subscribes to approved PatrolBot topics and
    streams normalized dashboard-protocol messages over an outbound WebSocket
    to the PatrolBot dashboard server. No motion commands (Phase 3).
  </description>
  <maintainer email="ymh1874@gmail.com">Yousef Hussein</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>patrolbot_interfaces</depend>
  <exec_depend>python3-websockets</exec_depend>
  <exec_depend>python3-psutil</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
